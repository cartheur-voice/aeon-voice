#!/usr/bin/env bash
set -euo pipefail

# Debian/Ubuntu helper for preparing an AeonVoice custom-voice training workspace.
# This script does not download HTK automatically (licensed download required).

usage() {
  cat <<'EOF'
Usage:
  setup_environment_debian --workdir <path> --htk-bindir <path> --hts22-bindir <path> [options]

Required:
  --workdir        Workspace path to create/use
  --htk-bindir     Path containing HTK binaries (HLEd/HVite/etc.)
  --hts22-bindir   Path containing HTS 2.2 binaries (HHEd)

Optional:
  --festdir        Existing Festival install path (default: <workdir>/festival)
  --bindir         Existing SPTK/HTS tool bin dir (default: <workdir>/bin)
  --praat          Path to praat binary (default: /usr/bin/praat)
  --repo           AeonVoice repository path (default: current directory)
  --skip-apt       Skip apt package installation
  --help

This script:
  1. Installs Debian packages needed for training helpers.
  2. Builds AeonVoice in dev mode (for local/bin utilities).
  3. Writes src/scripts/general/training.cfg with provided paths.
  4. Runs check_training_env.sh to validate tool availability.

EOF
}

WORKDIR=""
HTK_BINDIR=""
HTS22_BINDIR=""
FESTDIR=""
BINDIR=""
PRAAT_PATH="/usr/bin/praat"
REPO_PATH="$(pwd)"
SKIP_APT=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --workdir) WORKDIR="$2"; shift 2 ;;
    --htk-bindir) HTK_BINDIR="$2"; shift 2 ;;
    --hts22-bindir) HTS22_BINDIR="$2"; shift 2 ;;
    --festdir) FESTDIR="$2"; shift 2 ;;
    --bindir) BINDIR="$2"; shift 2 ;;
    --praat) PRAAT_PATH="$2"; shift 2 ;;
    --repo) REPO_PATH="$2"; shift 2 ;;
    --skip-apt) SKIP_APT=1; shift ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Unknown arg: $1" >&2; usage; exit 1 ;;
  esac
done

if [[ -z "$WORKDIR" || -z "$HTK_BINDIR" || -z "$HTS22_BINDIR" ]]; then
  usage
  exit 1
fi

REPO_PATH="$(realpath "$REPO_PATH")"
WORKDIR="$(realpath -m "$WORKDIR")"

if [[ -z "$FESTDIR" ]]; then
  FESTDIR="$WORKDIR/festival"
fi
if [[ -z "$BINDIR" ]]; then
  BINDIR="$WORKDIR/bin"
fi

link_cmd_into_bindir() {
  local cmd_name="$1"
  local dest="$BINDIR/$cmd_name"
  if [[ -x "$dest" ]]; then
    return
  fi
  local src
  src="$(command -v "$cmd_name" || true)"
  if [[ -n "$src" ]]; then
    ln -sf "$(realpath "$src")" "$dest"
  fi
}

install_packages() {
  if [[ "$SKIP_APT" -eq 1 ]]; then
    echo "Skipping apt package installation."
    return
  fi
  sudo apt-get update
  sudo apt-get install -y \
    build-essential \
    csh \
    curl \
    gawk \
    git \
    jq \
    libasound2-dev \
    libparallel-forkmanager-perl \
    libx11-dev \
    praat \
    python3 \
    python3-pip \
    scons \
    sox \
    wget
}

install_python_packages() {
  python3 -m pip install --user --upgrade pip
  python3 -m pip install --user \
    cython \
    matplotlib \
    numpy \
    pysoundfile \
    pyworld \
    scipy \
    webrtcvad
}

build_aeonvoice_dev() {
  pushd "$REPO_PATH" >/dev/null
  scons dev=True -j"$(nproc)"
  popd >/dev/null
}

write_training_cfg() {
  local cfg="$REPO_PATH/src/scripts/general/training.cfg"
  local tmp
  tmp="$(mktemp)"
  jq \
    --arg bindir "$BINDIR" \
    --arg htk_bindir "$HTK_BINDIR" \
    --arg hts22_bindir "$HTS22_BINDIR" \
    --arg festdir "$FESTDIR" \
    --arg praat_path "$PRAAT_PATH" \
    '.bindir=$bindir |
     .htk_bindir=$htk_bindir |
     .hts22_bindir=$hts22_bindir |
     .festdir=$festdir |
     .praat_path=$praat_path' \
    "$cfg" > "$tmp"
  mv "$tmp" "$cfg"
  echo "Updated training config: $cfg"
}

prepare_paths() {
  mkdir -p "$WORKDIR"
  mkdir -p "$BINDIR"
}

populate_bindir() {
  # These are expected by training.cfg["bindir"] and validation checks.
  link_cmd_into_bindir HCompV
  link_cmd_into_bindir mcep
  link_cmd_into_bindir pitch
}

validate() {
  "$REPO_PATH/src/scripts/general/check_training_env.sh" "$REPO_PATH/src/scripts/general/training.cfg"
}

prepare_paths
install_packages
install_python_packages
build_aeonvoice_dev
populate_bindir
write_training_cfg
validate

cat <<EOF
Environment setup completed.

Next:
  1) Create a clean training workspace:
     mkdir -p "$WORKDIR/henry-train" && cd "$WORKDIR/henry-train"
  2) Initialize HTS training scaffold:
     python3 "$REPO_PATH/src/scripts/general/voice-building-utils" init
  3) Continue with:
     python3 "$REPO_PATH/src/scripts/general/voice-building-utils" --help
EOF
