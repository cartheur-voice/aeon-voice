source g2pMap.foma
source phonemes.foma

define XEConsonant Consonant - ["/gs"] ; 

define insertE 
XEConsonant -> ... "/e0", 
EXConsonant -> "/e0" ... ; 
define Rules 
[g2pMap @->] 
.o. [["/g?": "/gj" | "/k?": "/kj"] ->] 
.o. insertE ; 

regex Rules ; 

