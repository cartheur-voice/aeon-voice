source alphabet.foma

define PB %- | .#. ; 
define WB %# | PB ; 

define StressMono 
pVowelStressMap -> || PB [\pVowel]* _ [\pVowel]* PB ; 

define Ihs2flag 
"/ihs0" -> "_l" ; 

# three vowels
source alphabet.foma
define stressToDistinguish 
  ["/i0":"/i1"] -> || "/i0" WB _ WB pVowel ,,
  ["/i0":"/i1"] -> ||  WB _ WB "/i0"  ,,
  ["/e0":"/e1"] -> || "/e0" WB _ WB pVowel ,,
  ["/e0":"/e1"] -> ||  WB _ WB "/e0" ; 

define Rules 
Ihs2flag 
.o. StressMono .o. stressToDistinguish
 ; 

regex Rules ; 
