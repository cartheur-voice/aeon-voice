define MaleOrdSuffix  (%-) [{ви} | {ри} | {ти} | {vi} | {ri} | {ti}] ; 
define MaleDefOrdSuffix  (%-) [{виот} | {риот} | {тиот} | {viot} | {riot} | {tiot}] ; 
define FemaleOrdSuffix  (%-) [{ва} | {ра} | {та} | {va} | {ra} | {ta}] ; 
define FemaleDefOrdSuffix  (%-) [{вата} | {рата} | {тата} | {vata} | {rata} | {tata}] ; 
define NeuterOrdSuffix  (%-) [{во} | {ро} | {то} | {vo} | {ro} | {to}] ; 
define NeuterDefOrdSuffix  (%-) [{вото} | {рото} | {тото} | {voto} | {roto} | {toto}] ; 
define OrdSuffix MaleOrdSuffix | FemaleOrdSuffix | NeuterOrdSuffix | MaleDefOrdSuffix | FemaleDefOrdSuffix | NeuterDefOrdSuffix; 
