<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AeonVoiceVersion Condition="'$(AeonVoiceVersion)' == ''">0.2.0</AeonVoiceVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AeonVoice" Version="$(AeonVoiceVersion)" />
  </ItemGroup>
</Project>
