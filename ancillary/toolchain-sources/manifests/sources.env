#!/usr/bin/env bash
# shellcheck shell=bash

# Version pins
export SPTK_VERSION="3.11"
export HTS_ENGINE_API_VERSION="1.10"

# Source URLs (open-source components only)
export SPTK_URL="https://downloads.sourceforge.net/project/sp-tk/SPTK/SPTK-${SPTK_VERSION}/SPTK-${SPTK_VERSION}.tar.gz"
export HTS_ENGINE_API_URL="https://downloads.sourceforge.net/project/hts-engine/hts_engine%20API/hts_engine_API-${HTS_ENGINE_API_VERSION}/hts_engine_API-${HTS_ENGINE_API_VERSION}.tar.gz"
export FESTIVAL_URL="https://github.com/festvox/festival/archive/refs/heads/master.tar.gz"
export SPEECH_TOOLS_URL="https://github.com/festvox/speech_tools/archive/refs/heads/master.tar.gz"

# Optional checksum slots (fill when you lock exact artifacts)
export SPTK_SHA256=""
export HTS_ENGINE_API_SHA256=""
export FESTIVAL_SHA256=""
export SPEECH_TOOLS_SHA256=""
